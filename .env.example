# Скопируйте в .env и поправьте под себя.
DATABASE_URL=postgresql+asyncpg://payment_emulator:payment_emulator@localhost:5432/payment_emulator
# AUTO_MIGRATE=true

# Первые учётки — создаются только на пустой базе, дальше управляются в админке.
API_USERNAME=agent
API_PASSWORD=agent-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=dev-only-change-me
